rules_version = '2';

// Only the owner's Firebase Auth account can read or write anything.
// To give another account access, add its User UID to the list below
// and run: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null
        && request.auth.uid in ['qZssjTeErbP2oPeBFKwH5C2phkF2'];
    }

    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
